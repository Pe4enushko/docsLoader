APP_NAME=medical-audit-pipeline
APP_ENV=dev
LOG_LEVEL=INFO
LOG_TO_FILES=true
LOG_DIR=logs
APP_LOG_FILE=app.log

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/med_audit
DB_ECHO=false

TIKA_URL=http://localhost:9998
TIKA_TIMEOUT_SECONDS=30

# OpenAI / OpenAI-compatible settings
OPENAI_API_KEY=<OPENAI_API_KEY>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RULE_EXTRACTOR_MODEL=gpt-4.1-mini
RULE_EXTRACTOR_FORCE_JSON_MODE=true
RULE_EXTRACTOR_SAVE_RAW_RESPONSES=true
RULE_EXTRACTOR_RAW_DIR=tmp/rule_extractor_raw

EMBEDDING_PROVIDER=openai
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=60
# Used when EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# LLM provider settings
# LLM_PROVIDER supports: openai | ollama
LLM_PROVIDER=openai
LLM_TIMEOUT_SECONDS=60
# Used when LLM_PROVIDER=ollama
OLLAMA_CHAT_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_CHAT_NUM_CTX=16384

RETRIEVAL_TOP_K=8
NORMATIVE_RULES_JSON_PATH=app/resources/normative_rules.json

# Batch guideline ingestion settings
GUIDELINES_DIR=docs
GUIDELINES_GLOB=*.pdf
GUIDELINES_RECURSIVE=true
INGEST_CLEAR_PREVIOUS=true
# Ingestion storage backend: postgres | mock
INGESTION_RAG_ADAPTER=postgres

# 1C retrieval settings
ONE_C_APPOINTMENTS_URL=<ONE_C_APPOINTMENTS_URL>
ONE_C_LOGIN=<ONE_C_LOGIN>
ONE_C_PASSWORD=<ONE_C_PASSWORD>
ONE_C_TIMEOUT_SECONDS=15
ONE_C_DATE_BEGIN=01.01.2026
ONE_C_DATE_END=01.01.2026
ONE_C_EXPORT_PATH=tmp/one_c_export.json

# Test data audit script settings
TEST_DATA_INPUT_PATH=tmp/test_visits_input.json
TEST_DATA_OUTPUT_PATH=tmp/test_visits_output.json
TEST_DATA_CONTINUE_ON_ERROR=true
TEST_DATA_BATCH_CONCURRENCY=4

# Single document test ingestion script settings
TEST_INGESTION_SOURCE_PATH=
TEST_INGESTION_OUTPUT_PATH=tmp/test_document_ingestion_result.json
TEST_INGESTION_DOCS_COUNT=1
TEST_INGESTION_RANDOM_SEED=
# Test ingestion storage backend override: postgres | mock
TEST_INGESTION_RAG_ADAPTER=postgres
